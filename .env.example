OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Database (SQLite for now, swapped to Postgres in Phase 7)
DATABASE_URL=sqlite+aiosqlite:///./data/finresearch.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# News API (get a free key at newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage (free tier at alphavantage.co)
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# App
APP_ENV=development
LOG_LEVEL=INFO
